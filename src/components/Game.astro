---
import BobaSugarNotes from './BobaSugarNotes.astro';
---
<div class="game-wrapper" lang="en" data-boba-customizer>
  <h2 class="game-title" id="game-title">Customize Your Boba!</h2>
  <p class="game-reference">A 500 mL reference drink · one cube ≈ 4 g total sugar</p>
  <section class="game-section" id="gameSection" aria-labelledby="game-title">
    <div id="container">
      <div id="menu-container">
        <p><label for="baseSelect">Base:</label></p>
        <select id="baseSelect">
          <option value="">Please select a base</option>
          <option>Green Tea</option>
          <option>Black Tea</option>
        </select>
        <fieldset>
          <legend>Milk:</legend>
          <div class="game-option"><input type="checkbox" id="milkCheckbox" /><label for="milkCheckbox"><span>Add Milk</span></label></div>
        </fieldset>
        <fieldset>
          <legend>Toppings:</legend>
          <div class="game-option"><input type="checkbox" id="bobaCheckbox" /><label for="bobaCheckbox"><span>Boba</span></label></div>
          <div class="game-option"><input type="checkbox" id="puddingCheckbox" /><label for="puddingCheckbox"><span>Pudding</span></label></div>
          <div class="game-option"><input type="checkbox" id="grassCheckbox" /><label for="grassCheckbox"><span>Grass Jelly</span></label></div>
          <div class="game-option"><input type="checkbox" id="konjacCheckbox" /><label for="konjacCheckbox"><span>Konjac</span></label></div>
        </fieldset>
        <p><label for="sugarSelect">Sugar:</label></p>
        <select id="sugarSelect" aria-describedby="syrup-model-note">
          <option>0%</option>
          <option>30%</option>
          <option>50%</option>
          <option>70%</option>
          <option>100%</option>
        </select>
        <p class="game-note" id="syrup-model-note">Illustrative syrup recipe: 100% adds 32 g sugar.</p>
        <button type="button" data-compare-button aria-expanded="false" aria-controls="drink-comparison">Compare Another Drink</button>
        <p class="game-note" data-editing-note></p>
      </div>
      <div class="make-drinks" data-current-illustration aria-hidden="true">
        <img style="opacity: 1;" src="img/make-drinks/teacup.png" alt="" />
        <img id="greentea" src="img/make-drinks/greentea.png" alt="" />
        <img id="blacktea" src="img/make-drinks/blacktea.png" alt="" />
        <img id="milk" src="img/make-drinks/milk.png" alt="" />
        <img id="milktea" src="img/make-drinks/milktea.png" alt="" />
        <img id="matchalatte" src="img/make-drinks/matchalatte.png" alt="" />
        <img id="bobo" src="img/make-drinks/bobo.png" alt="" />
        <img id="pudding" src="img/make-drinks/pudding.png" alt="" />
        <img id="grass-jelly" src="img/make-drinks/grass-jelly.png" alt="" />
        <img id="konjac" src="img/make-drinks/konjac.png" alt="" />
      </div>
      <div class="sugar-visual">
        <div id="sketch-container" aria-hidden="true"></div>
        <p class="game-note" data-renderer-note hidden>The cube illustration is unavailable. Sugar estimates and comparison still update below.</p>
        <div id="sugarDisplay">
          <p class="game-note" data-drink-label>Your drink</p>
          <p class="game-cube-count" data-cube-count>0 sugar cubes</p>
          <p class="game-total" data-total-sugar>0 g estimated total sugar</p>
          <p class="game-note" data-free-sugar>Estimated free sugar: 0 g.</p>
          <p class="game-note game-reference-notice" data-reference-notice>Estimated free sugar is within the 25 g daily reference.</p>
          <p class="game-note">25 g is a daily reference, not a per-drink safety limit. <a href="#sugar-methodology">How we estimate sugar</a></p>
        </div>
      </div>
    </div>
    <p class="game-note game-recipe" data-current-recipe>Tea base not selected · no milk · no toppings · 0% sweetness</p>
    <section class="game-comparison" id="drink-comparison" data-comparison aria-labelledby="comparison-title" hidden>
      <h3 id="comparison-title">Drink 1 · Fixed reference</h3>
      <div class="game-reference-drink">
        <div data-reference-illustration aria-hidden="true"></div>
        <img class="game-reference-cubes" data-reference-cubes hidden alt="" aria-hidden="true" width="300" height="500" />
        <div class="game-reference-text">
          <p data-reference-total></p>
          <p class="game-note" data-reference-free></p>
          <p class="game-note" data-reference-recipe></p>
          <p data-comparison-difference></p>
        </div>
      </div>
    </section>
    <BobaSugarNotes />
    <p class="game-sr-only" role="status" aria-atomic="true" data-status></p>
    <noscript><p>Enable JavaScript to customize the drink and update the sugar cubes and estimates.</p></noscript>
  </section>
</div>
<script>
  import { initCustomizer } from '../scripts/boba/customizer.js';
  document.querySelectorAll('[data-boba-customizer]').forEach(initCustomizer);
</script>
